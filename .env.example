MW_SERVER=https://wiki.dragonminez.com
DMZ_WEB_URL=https://dragonminez.com
DMZ_COOKIE_DOMAIN=.dragonminez.com
WIKI_PORT=8091

# Sign in with Discord through the Clerk instance of dragonminez.com.
# Same names and values as dragonminez-web (Clerk) and dragonminez-ai (DISCORD_TOKEN).
# The secrets go in Dokploy's Environment tab or in data/secrets/secrets.php
# ($dmzClerkSecretKey and $dmzDiscordBotToken). Never commit them.
PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
DISCORD_TOKEN=
# Optional: defaults to the official DragonMineZ server.
DISCORD_GUILD_ID=
# Emergency only: brings back username and password login.
MW_PASSWORD_LOGIN=0

MW_SMTP_HOST=
MW_SMTP_PORT=587
MW_SMTP_USER=
MW_EMAIL_FROM=wiki@dragonminez.com

BACKUP_KEEP_DAYS=14
BACKUP_RCLONE_REMOTE=
