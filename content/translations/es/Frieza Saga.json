 "Page_display_title": {
  "source": "Frieza Saga",
  "translation": "Saga Freezer",
  "outdated": false
 },
 "1": {
  "source": "[[Special:MyLanguage/Cui|Cui]], [[Special:MyLanguage/Dodoria|Dodoria]], [[Special:MyLanguage/Zarbon|Zarbon]], Vegeta, Ginyu Force, Frieza",
  "translation": "[[Special:MyLanguage/Cui|Cui]], [[Special:MyLanguage/Dodoria|Dodoria]], [[Special:MyLanguage/Zarbon|Zarbon]], Vegeta, Fuerzas Especiales Ginyu, Freezer",
  "outdated": false
 },
 "2": {
  "source": "The '''Frieza Saga''' is the third saga of the [[Special:MyLanguage/Sagas|story mode]]. It opens once you complete every quest of the [[Special:MyLanguage/Saiyan Saga|Saiyan Saga]] and takes place on [[Special:MyLanguage/Namek|Namek]]: Frieza's army, the Ginyu Force and Frieza's four forms in the Ajissa Plains, with stops at the Namekian Ruins, the Grand Elder's House and Frieza's Ship, a spar with Nail and [[Special:MyLanguage/Porunga|Porunga]]'s summoning, then the escape back to Earth.",
  "translation": "La '''Saga Freezer''' es la tercera saga del [[Special:MyLanguage/Sagas|modo historia]]. Se abre cuando completas todas las misiones de la [[Special:MyLanguage/Saiyan Saga|Saga Saiyajin]] y transcurre en [[Special:MyLanguage/Namek|Namek]]: el ejército de Freezer, las Fuerzas Especiales Ginyu y las cuatro formas de Freezer en las Llanuras de Ajissa, con paradas en las Ruinas namekianas, la Casa del Gran Anciano y la Nave de Freezer, un combate de práctica con Nail y la invocación de [[Special:MyLanguage/Porunga|Porunga]], y luego la huida de regreso a la Tierra.",
  "outdated": false
 },
 "3": {
  "source": "Completing every quest of the Frieza Saga opens the [[Special:MyLanguage/Android Saga|Android Saga]].",
  "translation": "Completar todas las misiones de la Saga Freezer abre la [[Special:MyLanguage/Android Saga|Saga Androides]].",
  "outdated": false
 },
 "4": {
  "source": "== Quests ==",
  "translation": "== Misiones ==",
  "outdated": false
 },
 "5": {
  "source": "Quests 17 to 22 were added to this saga later, so the list follows the '''Step''' (play order) rather than the quest number. Rewards are base values: see [[Special:MyLanguage/Sagas|Sagas]] for how your difficulty changes them.",
  "translation": "Las misiones 17 a 22 se añadieron a esta saga más tarde, así que la lista sigue el '''Paso''' (orden de juego) y no el número de misión. Las recompensas son valores base: consulta en [[Special:MyLanguage/Sagas|Sagas]] cómo las cambia tu dificultad.",
  "outdated": false
 },
