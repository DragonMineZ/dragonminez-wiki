 "2": {
  "source": "Garlic Jr., Dr. Wheelo, Turles, Lord Slug, Cooler, Metal Cooler, Android 13, Broly, Bojack, Bio-Broly, Janemba, Hirudegarn",
  "translation": "Garlic Jr., Dr. Wheelo, Turles, Lord Slug, Cooler, Metal Cooler, Androide 13, Broly, Bojack, Bio-Broly, Janemba, Hildegarn",
