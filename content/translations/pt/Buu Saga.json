 },
 "1": {
  "source": "[[Special:MyLanguage/Spopovich|Spopovich]], [[Special:MyLanguage/Pui Pui|Pui Pui]], [[Special:MyLanguage/Yakon|Yakon]], [[Special:MyLanguage/Dabura|Dabura]], Babidi, Majin Buu",
  "translation": "[[Special:MyLanguage/Spopovich|Spopovich]], [[Special:MyLanguage/Pui Pui|Pui Pui]], [[Special:MyLanguage/Yakon|Yakon]], [[Special:MyLanguage/Dabura|Dabura]], Babidi, Majin Boo",
