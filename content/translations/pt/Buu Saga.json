 },
 "2": {
  "source": "[[Special:MyLanguage/Sacred Kai Planet|Sacred Kai Planet]] (Space Pod)",
  "translation": "[[Special:MyLanguage/Sacred Kai Planet|Mundo Sagrado dos Kai]] (Cápsula Espacial)",
  "outdated": false
 },
 "3": {
  "source": "The '''Buu Saga''' is the fifth saga of the [[Special:MyLanguage/Sagas|story mode]]. It opens, together with the [[Special:MyLanguage/Future Saga|Future Saga]], once you complete every quest of the [[Special:MyLanguage/Android Saga|Android Saga]]. It covers flying lessons with Gohan, the World Tournament, Babidi's ship, [[Special:MyLanguage/Majin Buu|Majin Buu]] in all his forms, spars with Gotenks, Ultimate Gohan and Vegetto, the [[Special:MyLanguage/Hyperbolic Time Chamber|Hyperbolic Time Chamber]] and the final battle on the [[Special:MyLanguage/Sacred Kai Planet|Sacred Kai Planet]].",
  "translation": "A '''Saga Boo''' é a quinta saga do [[Special:MyLanguage/Sagas|modo história]]. Ela abre, junto com a [[Special:MyLanguage/Future Saga|Saga do Futuro]], quando você conclui todas as missões da [[Special:MyLanguage/Android Saga|Saga Androide]]. Ela cobre as aulas de voo com Gohan, o Torneio Mundial, a nave de Babidi, [[Special:MyLanguage/Majin Buu|Majin Boo]] em todas as suas formas, treinos de luta com Gotenks, Gohan Místico e Vegetto, a [[Special:MyLanguage/Hyperbolic Time Chamber|Sala do Tempo]] e a batalha final no [[Special:MyLanguage/Sacred Kai Planet|Mundo Sagrado dos Kai]].",
  "outdated": false
 },
 "4": {
  "source": "Completing every quest of the Buu Saga opens both the [[Special:MyLanguage/GT Saga|GT Saga]] and the [[Special:MyLanguage/Daima Saga|Daima Saga]]. You can play them in any order.",
  "translation": "Concluir todas as missões da Saga Boo abre tanto a [[Special:MyLanguage/GT Saga|Saga GT]] quanto a [[Special:MyLanguage/Daima Saga|Saga Daima]]. Você pode jogá-las em qualquer ordem.",
  "outdated": false
 },
 "5": {
  "source": "== Quests ==",
  "translation": "== Missões ==",
  "outdated": false
 },
 "6": {
  "source": "Quests 36 to 42 were added to this saga later, so the list follows the '''Step''' (play order) rather than the quest number. Rewards are base values: see [[Special:MyLanguage/Sagas|Sagas]] for how your difficulty changes them.",
  "translation": "As missões 36 a 42 foram adicionadas a esta saga depois, então a lista segue a '''Etapa''' (ordem de jogo) e não o número da missão. As recompensas são valores base: veja em [[Special:MyLanguage/Sagas|Sagas]] como a sua dificuldade as altera.",
  "outdated": false
 },
