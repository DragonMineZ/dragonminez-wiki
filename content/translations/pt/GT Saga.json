 "1": {
  "source": "Lord Luud, General Rilldo, Baby, Super 17, Shadow Dragons, Omega Shenron",
  "translation": "Lord Luud, General Rilldo, Baby, Super 17, Dragões Malignos, Omega Shenlong",
  "outdated": false
 },
 "2": {
  "source": "Hirudegarn quests of the [[Special:MyLanguage/Movies Saga|Movies Saga]]",
  "translation": "Missões de Hirudegarn da [[Special:MyLanguage/Movies Saga|Saga de Filmes]]",
  "outdated": false
 },
 "3": {
  "source": "The '''GT Saga''' is one of the two sagas that follow the [[Special:MyLanguage/Buu Saga|Buu Saga]] in the [[Special:MyLanguage/Sagas|story mode]]. It opens, together with the [[Special:MyLanguage/Daima Saga|Daima Saga]], once you complete every quest of the Buu Saga, and covers the Black Star Dragon Ball hunt on [[Special:MyLanguage/Namek|Namek]], Baby, Super 17 and the Shadow Dragons. Its fights take you across [[Special:MyLanguage/Earth|Earth]], Namek, the [[Special:MyLanguage/Sacred Kai Planet|Sacred Kai Planet]] and the [[Special:MyLanguage/Otherworld|Otherworld]].",
  "translation": "A '''Saga GT''' é uma das duas sagas que vêm depois da [[Special:MyLanguage/Buu Saga|Saga Boo]] no [[Special:MyLanguage/Sagas|modo história]]. Ela abre, junto com a [[Special:MyLanguage/Daima Saga|Saga Daima]], quando você conclui todas as missões da Saga Boo, e cobre a busca pelas Esferas do Dragão de Estrelas Negras em [[Special:MyLanguage/Namek|Namekusei]], Baby, Super 17 e os Dragões Malignos. As lutas levam você pela [[Special:MyLanguage/Earth|Terra]], por Namekusei, pelo [[Special:MyLanguage/Sacred Kai Planet|Mundo Sagrado dos Kai]] e pelo [[Special:MyLanguage/Otherworld|Outro Mundo]].",
  "outdated": false
 },
 "4": {
  "source": "The GT Saga and the Daima Saga can be played in any order.",
  "translation": "A Saga GT e a Saga Daima podem ser jogadas em qualquer ordem.",
  "outdated": false
 },
 "5": {
  "source": "== Quests ==",
  "translation": "== Missões ==",
  "outdated": false
 },
 "6": {
  "source": "Quests unlock one after another in the order below. Rewards are base values: see [[Special:MyLanguage/Sagas|Sagas]] for how your difficulty changes them.",
  "translation": "As missões são desbloqueadas uma após a outra na ordem abaixo. As recompensas são valores base: veja em [[Special:MyLanguage/Sagas|Sagas]] como a sua dificuldade as altera.",
  "outdated": false
 },
