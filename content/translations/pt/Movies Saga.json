 "2": {
  "source": "Garlic Jr., Dr. Wheelo, Turles, Lord Slug, Cooler, Metal Cooler, Android 13, Broly, Bojack, Bio-Broly, Janemba, Hirudegarn",
  "translation": "Garlic Jr., Dr. Wheelo, Turles, Lord Slug, Cooler, Metal Cooler, Androide 13, Broly, Bojack, Bio-Broly, Janemba, Hirudegarn",
  "outdated": false
 },
 "3": {
  "source": "Legendary Forms (levels 1 to 3)",
  "translation": "Formas Lendárias (níveis 1 a 3)",
  "outdated": false
 },
 "4": {
  "source": "The '''Movies Saga''' retells the DBZ movies, from Garlic Jr. to Hirudegarn. Unlike the other sagas of the [[Special:MyLanguage/Sagas|story mode]], it runs alongside the main story: its first quest opens after ''Defeat Raditz'' ([[Special:MyLanguage/Saiyan Saga|Saiyan Saga]] #1), and each later movie only opens once you have reached the matching point of the main story. Its fights take you across [[Special:MyLanguage/Earth|Earth]], [[Special:MyLanguage/Namek|Namek]] and the [[Special:MyLanguage/Otherworld|Otherworld]].",
  "translation": "A '''Saga de Filmes''' reconta os filmes de DBZ, de Garlic Jr. a Hirudegarn. Diferente das outras sagas do [[Special:MyLanguage/Sagas|modo história]], ela corre em paralelo à história principal: a primeira missão abre depois de ''Derrote Raditz'' ([[Special:MyLanguage/Saiyan Saga|Saga Saiyajin]] #1), e cada filme seguinte só abre quando você chega ao ponto correspondente da história principal. As lutas levam você pela [[Special:MyLanguage/Earth|Terra]], por [[Special:MyLanguage/Namek|Namekusei]] e pelo [[Special:MyLanguage/Otherworld|Outro Mundo]].",
  "outdated": false
 },
 "5": {
  "source": "The Broly, Bio-Broly and Hirudegarn movies unlock the '''Legendary Forms''' skill one level at a time, and Super Janemba rewards the [[Special:MyLanguage/Dimension Sword|Dimension Sword]].",
  "translation": "Os filmes de Broly, Bio-Broly e Hirudegarn desbloqueiam a habilidade '''Formas Lendárias''' um nível por vez, e Super Janemba dá como recompensa a [[Special:MyLanguage/Dimension Sword|Espada Dimensional]].",
  "outdated": false
 },
 "6": {
  "source": "== Quests ==",
  "translation": "== Missões ==",
  "outdated": false
 },
 "7": {
  "source": "The '''Opens after''' column shows the main-story quest each movie waits for, on top of the previous quest of this saga. Rewards are base values: see [[Special:MyLanguage/Sagas|Sagas]] for how your difficulty changes them.",
  "translation": "A coluna '''Abre depois de''' mostra a missão da história principal que cada filme espera, além da missão anterior desta saga. As recompensas são valores base: veja em [[Special:MyLanguage/Sagas|Sagas]] como a sua dificuldade as altera.",
  "outdated": false
 },
