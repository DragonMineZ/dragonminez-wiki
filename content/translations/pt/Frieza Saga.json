{
 "Page_display_title": {
  "source": "Frieza Saga",
  "translation": "Saga Freeza",
  "outdated": false
 },
 "1": {
  "source": "[[Special:MyLanguage/Cui|Cui]], [[Special:MyLanguage/Dodoria|Dodoria]], [[Special:MyLanguage/Zarbon|Zarbon]], Vegeta, Ginyu Force, Frieza",
  "translation": "[[Special:MyLanguage/Cui|Cui]], [[Special:MyLanguage/Dodoria|Dodoria]], [[Special:MyLanguage/Zarbon|Zarbon]], Vegeta, Força Ginyu, Freeza",
  "outdated": false
 },
 "2": {
  "source": "The '''Frieza Saga''' is the third saga of the [[Special:MyLanguage/Sagas|story mode]]. It opens once you complete every quest of the [[Special:MyLanguage/Saiyan Saga|Saiyan Saga]] and takes place on [[Special:MyLanguage/Namek|Namek]]: Frieza's army, the Ginyu Force and Frieza's four forms in the Ajissa Plains, with stops at the Namekian Ruins, the Grand Elder's House and Frieza's Ship, a spar with Nail and [[Special:MyLanguage/Porunga|Porunga]]'s summoning, then the escape back to Earth.",
  "translation": "A '''Saga Freeza''' é a terceira saga do [[Special:MyLanguage/Sagas|modo história]]. Ela abre quando você conclui todas as missões da [[Special:MyLanguage/Saiyan Saga|Saga Saiyajin]] e se passa em [[Special:MyLanguage/Namek|Namekusei]]: o exército de Freeza, a Força Ginyu e as quatro formas de Freeza nas Planícies de Ajissa, com paradas nas Ruínas namekuseijins, na Casa do Grande Ancião e na Nave do Freeza, um treino de luta com Nail e a invocação de [[Special:MyLanguage/Porunga|Porunga]], e depois a fuga de volta para a Terra.",
  "outdated": false
 },
 "3": {
  "source": "Completing every quest of the Frieza Saga opens the [[Special:MyLanguage/Android Saga|Android Saga]].",
  "translation": "Concluir todas as missões da Saga Freeza abre a [[Special:MyLanguage/Android Saga|Saga Androide]].",
  "outdated": false
 },
 "4": {
  "source": "== Quests ==",
  "translation": "== Missões ==",
  "outdated": false
 },
 "5": {
  "source": "Quests 17 to 22 were added to this saga later, so the list follows the '''Step''' (play order) rather than the quest number. Rewards are base values: see [[Special:MyLanguage/Sagas|Sagas]] for how your difficulty changes them.",
  "translation": "As missões 17 a 22 foram adicionadas a esta saga depois, então a lista segue a '''Etapa''' (ordem de jogo) e não o número da missão. As recompensas são valores base: veja em [[Special:MyLanguage/Sagas|Sagas]] como a sua dificuldade as altera.",
  "outdated": false
 },
