<section class="dmz-hero" aria-labelledby="dmz-hero-title">
	<img src="{{dmz-hero-src}}" alt="" class="dmz-hero__image" fetchpriority="high">
	<div class="dmz-hero__content">
		<h2 class="dmz-hero__title" id="dmz-hero-title">{{msg-dmz-home-hero-title}}</h2>
		<p class="dmz-hero__subtitle">{{msg-dmz-home-hero-subtitle}}</p>
		<button type="button" class="dmz-hero__search" data-dmz-search-open>
			<span class="dmz-hero__search-text">{{msg-dmz-search-placeholder}}</span>
			<span class="material-symbols-rounded" aria-hidden="true">search</span>
		</button>
	</div>
</section>
